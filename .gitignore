game/
out/
tmp/
dist/
_tools/logs/
_tools/captures/
# Recompiled game code: regenerated by `rex build` from your own game files.
# Keep rexglue.cmake: CMakeLists.txt includes it and it defines the codegen
# target, so a fresh clone can't configure (or regenerate the rest) without it.
generated/*
!generated/rexglue.cmake
